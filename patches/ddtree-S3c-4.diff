+    def _ddtree_compact_kv_cache(
+        self,
+        accepted_paths: list[list[int]],
+        spec_decode_metadata: SpecDecodeMetadata,
+        dry_run: bool = False,
+    ) -> dict[str, int]:
+        """S3c-4: per-request, per-layer KV slot compaction.
+
+        For each request r with accepted tree path
+        ``[0, c1, c2, ..., cK]`` (root + K visited children) and for
+        each target attention layer, copy the KV at the scattered
+        verify-time slot of node ``ci`` to the contiguous prefix
+        position ``i``. This makes vLLM's standard "first K accepted"
+        contiguous-prefix assumption hold even though tree-follow
+        accepts non-contiguous nodes.
+
+        Locating slots:
+          * ``self._ddtree_verify_slot_mappings[layer]`` is the
+            per-layer ``slot_mapping`` tensor stashed in
+            ``_build_attn_group_metadata`` at the start of this round.
+            Its entries are absolute KV slot indices (block * size +
+            offset) for each query token's KV write.
+          * For request r with budget tree-node draft tokens, the
+            request's slice in ``slot_mapping`` starts at the
+            cumulative query offset computed below.
+          * ``kv_cache[block_id, :, offset, ...]`` holds both K and V
+            (dim 1 is the K/V channel after layout normalization).
+
+        Args:
+            accepted_paths: per-request walk paths
+              (``path[0] = 0`` root, ``path[1..K]`` visited child node
+              indices).
+            spec_decode_metadata: provides ``num_draft_tokens`` per
+              request, used to compute per-request flat query offset.
+            dry_run: when True, count what would be copied without
+              actually mutating the KV tensors. Useful for measuring
+              the path-length distribution without changing the
+              model's downstream behavior. Note: with dry_run=True the
+              accept path still affects the sampler output, so the
+              model trajectory still diverges — pair with
+              ``_DDTREE_ENABLE_TREE_FOLLOW=False`` for a pure shadow
+              measurement.
+
+        Returns:
+            Stats dict with counts: ``requests`` processed,
+            ``copies`` performed (or simulated), ``skipped`` due to
+            shape mismatches or missing state.
+        """
+        stats = {"requests": 0, "copies": 0, "skipped": 0}
+        if not accepted_paths:
+            return stats
+        if not self._ddtree_kv_caches_by_layer:
+            stats["skipped"] += 1
+            return stats
+        if not self._ddtree_verify_slot_mappings:
+            stats["skipped"] += 1
+            return stats
+
+        num_draft_tokens = spec_decode_metadata.num_draft_tokens
+        # Cumulative flat-query offset per request. For a uniformly-
+        # speced batch (e.g., 1 + budget per request), this is just
+        # r * (budget+1); the explicit cumsum handles mixed widths.
+        query_starts: list[int] = []
+        cumsum = 0
+        for r in range(len(num_draft_tokens)):
+            query_starts.append(cumsum)
+            cumsum += num_draft_tokens[r] + 1
+
+        device = self.device
+        warned_local = False
+        for req_idx, path in enumerate(accepted_paths):
+            if req_idx >= len(query_starts):
+                stats["skipped"] += 1
+                continue
+            if len(path) <= 1:
+                # Only root walked; nothing to compact.
+                stats["requests"] += 1
+                continue
+            K = len(path) - 1
+            q_start = query_starts[req_idx]
+
+            src_q_indices = torch.tensor(
+                [q_start + path[i] for i in range(1, K + 1)],
+                dtype=torch.long,
+                device=device,
+            )
+            dst_q_indices = torch.tensor(
+                [q_start + i for i in range(1, K + 1)],
+                dtype=torch.long,
+                device=device,
+            )
+
+            for layer_name, kv_cache in self._ddtree_kv_caches_by_layer.items():
+                slot_mapping = self._ddtree_verify_slot_mappings.get(
+                    layer_name
+                )
+                if slot_mapping is None:
+                    continue
+                if not isinstance(kv_cache, torch.Tensor) or kv_cache.dim() < 3:
+                    continue
+                # After ``_update_hybrid_attention_mamba_layout``, the
+                # attention KV cache shape is
+                # ``[num_blocks, 2, block_size, num_kv_heads, head_dim]``.
+                # block_size is the THIRD dim. Mamba layers don't fit
+                # this shape and are filtered out by the dim check
+                # above OR by the lack of slot_mapping entry.
+                block_size = int(kv_cache.shape[2])
+                if block_size <= 0:
+                    continue
+                try:
+                    src_slots = slot_mapping.index_select(0, src_q_indices)
+                    dst_slots = slot_mapping.index_select(0, dst_q_indices)
+                except (IndexError, RuntimeError) as exc:
+                    stats["skipped"] += 1
+                    if not warned_local:
+                        warned_local = True
+                        logger.warning(
+                            "ddtree compaction: slot_mapping index error "
+                            "in layer %s (likely mixed prefill+spec "
+                            "batch). Skipping further layers for req=%d. "
+                            "%s",
+                            layer_name,
+                            req_idx,
+                            exc,
+                        )
+                    break
+                src_blocks = src_slots // block_size
+                src_offsets = src_slots % block_size
+                dst_blocks = dst_slots // block_size
+                dst_offsets = dst_slots % block_size
+                if dry_run:
+                    stats["copies"] += K
+                    continue
+                # Clone to avoid aliasing if src and dst slot index
+                # tensors share entries.
+                src_view = kv_cache[src_blocks, :, src_offsets].clone()
+                kv_cache[dst_blocks, :, dst_offsets] = src_view
+                stats["copies"] += K
+            stats["requests"] += 1
+
+        return stats
+
+    def _ddtree_log_kv_layout_audit(self) -> None:
+        """One-time INFO dump of KV cache layout for debugging.
+
+        Emits one log block describing each layer's KV cache tensor
+        shape, dtype, device, derived block_size, and the head/dim
+        geometry. The compaction routine relies on the layout
+        ``[num_blocks, 2, block_size, num_kv_heads, head_dim]``; this
+        log surfaces any divergence so a user can diagnose issues
+        without re-running the server with a debugger attached.
+        """
+        if self._ddtree_kv_layout_logged:
+            return
+        if not self._ddtree_kv_caches_by_layer:
+            return
+        self._ddtree_kv_layout_logged = True
+        lines = ["ddtree KV layout audit:"]
+        sample = list(self._ddtree_kv_caches_by_layer.items())[:3]
+        for layer_name, kv_cache in sample:
+            try:
+                shape = tuple(kv_cache.shape)
+                dtype = str(kv_cache.dtype)
+                device = str(kv_cache.device)
+                ndim = kv_cache.dim()
+                block_size = int(kv_cache.shape[2]) if ndim >= 3 else -1
+                kv_channel_dim_size = (
+                    int(kv_cache.shape[1]) if ndim >= 2 else -1
+                )
+            except Exception as exc:  # pragma: no cover - defensive
+                lines.append(f"  {layer_name}: <inspect failed: {exc}>")
+                continue
+            lines.append(
+                f"  {layer_name}: shape={shape} dtype={dtype} "
+                f"device={device} block_size(dim2)={block_size} "
+                f"kv_channel(dim1)={kv_channel_dim_size}"
+            )
+        total = len(self._ddtree_kv_caches_by_layer)
+        if total > len(sample):
+            lines.append(f"  ... (and {total - len(sample)} more layers)")
+        logger.info("\n".join(lines))
+
     def _bookkeeping_sync(
         self,
         scheduler_output: "SchedulerOutput",
@@ -7242,6 +7492,14 @@ class GPUModelRunner(
             self.kv_caches,
             num_attn_module,
         )
+
+        # S3c-4 (ddtree): keep a per-layer-name reference so the
+        # compaction routine can locate each layer's KV tensor. We use
+        # a shallow dict copy so reshape/binding modifications later
+        # don't break the reference.
+        self._ddtree_kv_caches_by_layer = dict(kv_caches)
+        self._ddtree_log_kv_layout_audit()
+
         return kv_caches
 
     def maybe_add_kv_sharing_layers_to_kv_cache_groups(
